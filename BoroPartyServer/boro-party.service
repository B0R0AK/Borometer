[Unit]
Description=Boro Party Server
After=network.target

[Service]
Type=simple
# adjust this path if you put the files somewhere other than /opt/boro-party
WorkingDirectory=/opt/boro-party
ExecStart=/usr/bin/python3 /opt/boro-party/boro_server.py
Restart=on-failure
RestartSec=3

# it opens no socket outside its own port. The only files it writes are the
# guilds (boro_gilde.py), in its own state folder /var/lib/boro-party; a
# locked-down user account is enough, no special permissions needed
StateDirectory=boro-party
Environment=BORO_GILDE_DIR=/var/lib/boro-party/gilden
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
