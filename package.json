{
  "name": "borometer",
  "productName": "Borometer",
  "version": "1.9.0",
  "description": "Borometer - a DPS meter for Throne and Liberty that reads the combat log the game writes to disk.",
  "author": "B0R0AK",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/B0R0AK/Borometer",
  "repository": {
    "type": "git",
    "url": "https://github.com/B0R0AK/Borometer.git"
  },
  "bugs": {
    "url": "https://github.com/B0R0AK/Borometer/issues"
  },
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "node scripts/build-renderer.mjs",
    "build": "npm run build:main && npm run build:renderer",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "audit:safety": "node scripts/safety-audit.mjs",
    "audit:negative": "node scripts/audit-negative.mjs",
    "start": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:dir": "npm run build && electron-builder --dir",
    "test:best-core": "node scripts/test-best-core.mjs",
    "test:best-page": "npm run build:renderer && node scripts/test-best-page.mjs",
    "test:builds-core": "node scripts/test-builds-core.mjs",
    "test:plan-core": "node scripts/test-plan-core.mjs",
    "test:live-core": "node scripts/test-live-core.mjs",
    "test:live-page": "npm run build:renderer && node scripts/test-live-page.mjs",
    "test:analyse-core": "node scripts/test-analyse-core.mjs",
    "test:mechanik-core": "node scripts/test-mechanik-core.mjs",
    "test:analyse-page": "npm run build:renderer && node scripts/test-analyse-page.mjs",
    "test:rotation-core": "node scripts/test-rotation-core.mjs",
    "test:rotation-page": "npm run build:renderer && node scripts/test-rotation-page.mjs",
    "test:lage-core": "node scripts/test-lage-core.mjs",
    "test:verlauf-core": "node scripts/test-verlauf-core.mjs",
    "test:weeklies-core": "node scripts/test-weeklies-core.mjs",
    "test:rekorde-core": "node scripts/test-rekorde-core.mjs",
    "test:glutring-core": "node scripts/test-glutring-core.mjs",
    "test:kerne-core": "node scripts/test-kerne-core.mjs",
    "test:spielbilder-core": "node scripts/test-spielbilder-core.mjs",
    "test:weeklies-store": "node scripts/test-weeklies-store.mjs",
    "test:update-core": "node scripts/test-update-core.mjs",
    "test:extras-page": "npm run build:renderer && node scripts/test-extras-page.mjs",
    "test:rahmen-page": "npm run build:renderer && node scripts/test-rahmen-page.mjs",
    "test:tafel-page": "npm run build:renderer && node scripts/test-tafel-page.mjs",
    "test:einst-page": "npm run build:renderer && node scripts/test-einst-page.mjs",
    "test:felder-page": "npm run build:renderer && node scripts/test-felder-page.mjs",
    "test:neu-page": "npm run build:renderer && node scripts/test-neu-page.mjs",
    "test:weeklies-page": "npm run build:renderer && node scripts/test-weeklies-page.mjs",
    "test:tage-page": "npm run build:renderer && node scripts/test-tage-page.mjs",
    "test:rundgang-page": "npm run build:renderer && node scripts/test-rundgang-page.mjs",
    "test:rekorde-page": "npm run build:renderer && node scripts/test-rekorde-page.mjs",
    "installer-art": "node scripts/build-installer-art.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "playwright": "1.56.1",
    "typescript": "^7.0.2"
  }
}
